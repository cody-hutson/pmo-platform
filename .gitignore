# Operations domain — all operational data, session state, project files
# (mirrored from v1; v2 will host its own modules but operator-instance content stays separate)
projects/
portfolio/
steering-committee/

# Operator-instance content — never commit
# Two separate things, both ignored, for different reasons:
#   personal/     the operator's own area (working notes, analysis, harness). The
#                 platform provisions nothing here and homes no runtime state here.
#   pmo-instance/ platform-written runtime state — the operator-instance family's
#                 canonical home, a workspace-root sibling of projects/ and
#                 knowledge/. Resolved by core/deploy/lib-instance-path.sh.
# Both stems stay ignored: personal/ because it is operator-owned, and pmo-instance/
# because it holds machine-written state that must never reach a public commit.
personal/
pmo-instance/

# Initiative-roadmap instances — operator-local planning artifacts, never tracked
# (the roadmap *framework* at core/standards/initiative-roadmap-framework.md stays
#  tracked; the *instances* are authored operator-local per core/ADRs/ADR-012).
# Canonical home is repo-root /roadmaps/ (ships on install: folder + README tracked,
# instances git-ignored — the analysis/ workspace pattern, per ADR-046). The
# <OPERATOR_INSTANCE_ROADMAPS_PATH> token defaults to /roadmaps/ and is repointable.
/roadmaps/*
!/roadmaps/README.md
# Legacy pre-/roadmaps/ module dirs — kept ignored so any existing local content stays
# untracked; superseded as the canonical home by /roadmaps/ (ADR-046).
core/governance/roadmaps/
release/governance/roadmaps/
operations/governance/roadmaps/

# Deployment targets — installed skills and local CC overrides
.claude/skills/
.claude/settings.local.json

# Public-flip leak-scan oracle (scan.sh) + its needles — operator-LOCAL, never tracked.
# scan.sh is the detector; it loads operator-specific literals at runtime from the
# gitignored needles (hardcoding them would make the detector itself a leak). Canonical
# home for the script + needles is the operator-instance dir (already ignored);
# these lines also block a stray repo-local copy from being committed.
/scan.sh
flip-scan-needles.txt
.flip-scan-needles.txt

# Localized-context PII needles (#1830) — operator-LOCAL, never tracked. The real
# file holds coworker/org names + the org email domain that must not enter the
# public repo. Its canonical home is the operator-instance dir (already ignored by
# personal/ + pmo-instance/ above); this defensive pattern also blocks a stray copy
# anywhere in the tree. The .example TEMPLATE at core/config/ IS tracked (negated).
**/localized-context-needles.txt
!**/localized-context-needles.txt.example

# people-roster stray-copy backstop. The filled roster is operator-instance and
# out-of-tree (the PRIMARY protection — a repo commit cannot reach a sibling dir);
# this pattern additionally blocks a stray in-tree copy anywhere, while the shipped
# de-identified template stays tracked (negated). Mirrors the needle-file .example idiom.
**/people-roster.yaml
!**/people-roster-template.yaml

# FinOps usage store (#3909) — operator-instance runtime token-spend data. Usage
# records carry gitBranch / cwd (operator home path) / work-item identifiers, so on a
# PUBLIC repo they must never commit. Canonical home is the operator-instance dir
# (already ignored by personal/ + pmo-instance/ above); these defensive stems also
# block a stray copy anywhere in the tree. Runtime enforcement is the extractor's
# resolve-time git check-ignore guard (fail-closed); these patterns are defense-in-depth.
**/pmo-instance/finops/
**/finops/usage.jsonl

# Secret files (per core/standards/secrets-handling-policy.md §3)
# Categories C3 (MCP tokens) and C5 (project-specific) may land in .env;
# .example / .template / .sample variants ARE tracked (public-facing schemas).
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Resolved operator config — the .template ships; the real file (identity, paths,
# audit_repo) resolves at ~/.config/pmo-platform/ and must never be tracked. Guards
# against a stray copy created next to core/config/operator.toml.template.
operator.toml
operator.local.toml

# Plugin data
memory/

# OS artifacts
**/.DS_Store
**/Thumbs.db

# Local IDE / Claude Code worktree state
.vscode/
.idea/
.claude/launch.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Hook runtime artifacts — append-only logs and state, never committed
.claude/hooks/*.log
.claude/hooks/*.jsonl
.claude/hooks/.mode
# Per-hook dedicated mode files (.autonomy-mode, .scope-segregation-mode,
# .verify-session-config-mode, .gh-path-leak-mode). Same class as .mode above:
# the live value is operator-local runtime state. The glob does NOT match .mode
# itself (no -mode suffix) nor a *.template (different suffix), so the shipped
# posture stays tracked while the operator's setting does not.
.claude/hooks/.*-mode
.claude/hooks/.session-retro-state/
# Source-tree hook runtime artifacts (produced when hooks run from the worktree
# during engineering/testing). The committed source is the .sh + .mode.template;
# the live .mode and the per-hook logs are runtime-only.
core/hooks/*.log
core/hooks/*.jsonl
core/hooks/.mode
core/hooks/.*-mode
core/hooks/.session-retro-state/

# pmo-skill-editor runtime sentinels — session markers, never committed
# (v2 modular-monolith path; v1 was pmo-platform/skills/*/.editor-session)
operations/skills/*/.editor-session
release/skills/*/.editor-session
core/skills/*/.editor-session

# Obsidian vault metadata (user-specific UI state)
**/.obsidian/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Node build artifacts (reserved for future docs tooling)
node_modules/

# Skill-creator iteration workspaces (sibling to skill; test evidence, not product)
# (paths follow new modular structure per P2-T3/T4/T5 migration)
operations/skills/*-workspace/
release/skills/*-workspace/
core/skills/*-workspace/

# Cross-module audit reports — point-in-time evidence regenerable by the tool, never committed
# (cross-module-audit.sh default output path)
audit-output/

# Repo-scoped analysis workspace — operator working material, never committed.
# Read-once release/backlog/audit analysis ABOUT the platform (NOT projects/other). The
# empty folder + its README signpost ship (tracked); everything written here (dated
# <name>-YYYY-MM-DD/ subfolders) is git-ignored. Convention + frontmatter + sunset rule:
# core/standards/analysis-workspace-standard.md.
/analysis/*
!/analysis/README.md

# Legacy _validation/ folder — historical evidence removed; ignored to prevent accidental regeneration
_validation/

# hooks runtime logs/state (machine-specific; accumulate cwd PII — never track)
core/hooks/*.jsonl
core/hooks/*.log
core/hooks/.mode
