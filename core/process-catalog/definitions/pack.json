  "forbidden_phrases": [
    {
      "phrase": "L4 task",
      "use": "L4 step",
      "severity": "error",
      "why": "the glossary defines Task as the per-stage sub-task issue; the lowest operational unit is a Step"
    },
    {
      "phrase": "Verify stage",
      "use": "the stage's real name",
      "severity": "error",
      "why": "the pipeline has no Verify stage"
    },
    {
      "phrase": "Stage 14",
      "use": "Stage 13 Close or a named post-release activity",
      "severity": "error",
      "why": "the pipeline has 13 stages"
    }
  ],
