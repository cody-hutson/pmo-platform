# pmo-platform — platform-config.toml
#
# Canonical platform-BEHAVIOR configuration surface. Holds the parameterized
# platform-behavior choices the pipeline tunes over time: bundling frame +
# release-size target, the release-class enum default, and relationship-mapping
# tuning. Composition-surface category per core/standards/composition-surface-spec.md §1.
#
# DISTINCT from operator.toml: operator.toml is the operator-ENVIRONMENT /
# IDENTITY surface (identity, paths, [adapters] host-selectors, methodology
# default — ADR-017 §S2; chmod 600; depersonalization token vocabulary). This
# file is the platform-BEHAVIOR surface (frequently-calibrated tuning, no PII).
# The split is documented in core/ADRs/ADR-022-platform-config-vs-operator-toml-split.md
# (refines/extends ADR-017 S2 — relocates nothing).
#
# Canonical location (Layer 1 — global DEFAULTS, this file, git-tracked):
#   core/config/platform-config.toml.template  — schema + global default values
#
# Per-tier override VALUES (Layer 2 — operator-instance, git-ignored) live at:
#   ~/.config/pmo-platform/platform-config.toml  [overrides]  — individual-tier (XDG)
#   <workspace>/projects/_config/PORTFOLIO.md frontmatter  platform_config: {...}  — portfolio
#   <workspace>/projects/<Program>/_config/program-config.toml  — program-tier
#   <workspace>/projects/<Project>/PROJECT.md frontmatter  platform_config: {...}  — project
#
# Resolution (5-rung; most-specific wins) per
# core/governance/OPERATIONS.md § Platform-Config Resolution Protocol:
#   global default (this file) → portfolio → program → project → individual
#
# Update governance is two-track (OPERATIONS.md § Platform-Config Resolution
# Protocol): editing a DEFAULT or the schema here = Track A (full governed PR —
# this is a governance file); setting a per-tier VALUE in a Layer-2 surface =
# Track B (operator-instance write, no PR).
#
# Every field below ships a global default so a fresh install resolves a value
# for every field with no operator action. The field schema (type / allowed
# values / calibration policy / consuming surface) is at
# core/schemas/platform-config-schema.md; the human-readable catalog is at
# docs/platform-config-reference.md.
#
# NOTE: this source template carries NO managed-section / operator-additions
# fences. Those are added at install time by core/deploy/compose.py
# (write_managed_file wraps the whole template in a MANAGED SECTION + appends an
# empty OPERATOR ADDITIONS fence) — matching every other composition-surface
# source file (the allowlists, the hub-state templates). Do NOT hand-add fences
# here; that would double-wrap at install and break update.sh's no-op detection.

[meta]
# Schema version. Bump on breaking schema changes (Track A governed PR).
schema_version = 1

# Identification of the managing tool. Do not edit.
managed_by = "pmo-platform"

[bundling]
# Bundle-composition frame the platform applies when deciding what coheres as a
# single shippable release. Drives release-planner Mode A / Mode B and the
# bundle-composition-doctrine § 1 frame anchor. The doctrine prose stays
# frame-pluggable — swapping this value re-anchors § 1 + § 2 terminology without
# rewriting the doctrine's structural rules (§ 3-§ 9 are frame-independent).
# The frame catalog (F1 / surveyed alternatives) is canonical in
# release/references/standards/bundle-composition-doctrine.md § 1 — this field
# does NOT re-list it.
# Valid: "F1" (SAFe Feature-Slicing + Vertical Slice — the v1 default) |
#        "F2" | "F3" | custom frame id declared in the doctrine.
# Default: "F1"
bundle_doctrine_frame = "F1"

# Release-size target band (story points) the bundle size-check (§ 3 Step 5)
# evaluates a candidate bundle against. Expressed as a "low-high" range string.
# Calibration policy: CALIBRATE-AFTER-3 — revisit after 3 releases of empirical
# velocity data (Track A governed change to re-set the default).
# Valid: a "low-high" points range string (e.g., "15-25").
# Default: "15-25"
release_size_target_pts = "15-25"

# Risk-weighted release-capacity multipliers, keyed on the milestone's declared
# Release Class. The bundle size-check (§ 3 Step 5) computes
# effective_pts = round_half_up( sum(member_pts) * class_weight ) and evaluates
# effective_pts (NOT raw points) against release_size_target_pts. This makes a
# higher-ceremony release's raw points count for more against the same band — a
# cross-cutting bundle of raw 20 pts resolves to effective 26 and crosses the
# >25 "split" disposition where raw points would have read "target band." The
# weight resolves from the milestone's "## Release Class" H2 (guaranteed present
# by gate G3-10), falling back to default_release_class (below) when absent.
# The class enum is CLOSED and canonical in
# release/references/specs/release-class-taxonomy.md; this field maps each class
# to its capacity weight, it does NOT re-define the enum. The formula, the
# rounding mode (round-half-up), and the band relationship are canonical in
# release/references/standards/bundle-composition-doctrine.md § 3 Step 5 — this
# field is the single NUMERIC home for the weights; the doctrine cites it by role
# and does NOT restate these numbers.
# Calibration policy: CALIBRATE-AFTER-3 — these are MEDIUM-confidence seeds;
# recalibrate from per-class delivered-vs-planned actuals after 3 releases of
# RELEASE_LOG velocity data (Track A governed change to re-set the defaults).
# Valid: a TOML inline table mapping each of the 4 release-class names to a
#        positive decimal weight.
# Default: { routine = 1.0, novel = 1.15, cross-cutting = 1.3, hotfix = 0.9 }
release_class_capacity_weights = { routine = 1.0, novel = 1.15, cross-cutting = 1.3, hotfix = 0.9 }

# Minimum acceptable release-planner Mode A combined-clean parse rate, expressed
# as a 0.0-1.0 fraction. Gate G3-14 asserts the Mode A combined-clean parse rate
# (issues parsing "clean" / issues with a determinate parse outcome) against this
# floor at the Stage 3 -> 4 (Bundle -> Planning) boundary, computed over the
# conformant-bundleable denominator (release-planner SKILL.md Step 1.5 partition
# group 1 — improvement|bug bodies with a recognized "### Affected Files" heading;
# type-excluded, needs-body-repair, and operator-deferred bodies are NOT in the
# denominator). The gate reads this field by role and never restates the magnitude
# (parameterize-over-hardcode), so a recalibration moves the floor without a
# gate-spec edit — exactly how release_size_target_pts is consumed. The criterion,
# the denominator, and the warn-then-enforce posture are canonical in
# core/schemas/gate-criteria-spec.md § Gate 3 (G3-14); this field is the single
# NUMERIC home for the floor and does NOT restate them.
# Calibration policy: CALIBRATE-AFTER-3 — the 0.90 seed is a MEDIUM-confidence
# value; recalibrate from observed Mode A parse-quality after 3 releases (Track A
# governed change to re-set the default). G3-14 ships warn-then-enforce so the
# floor calibrates before it gains teeth.
# Valid: a decimal fraction in [0.0, 1.0].
# Default: 0.90
mode_a_parse_rate_floor = 0.90

[release_class]
# The default Release Class applied when a milestone description carries no
# explicit "## Release Class" H2 section. The enum is CLOSED — 4 values — and
# is canonical in release/references/specs/release-class-taxonomy.md; this field
# does NOT re-define it, it only names the install default + the resolver
# fallback. A milestone's own declared class always overrides this default.
# Valid: "routine" | "novel" | "cross-cutting" | "hotfix"
#        (per release-class-taxonomy.md Class Enum — CLOSED).
# Default: "novel"  (conservative default — more engagement/review than routine;
#          a release that is genuinely routine declares so explicitly).
default_release_class = "novel"

[relationship_mapping]
# Relationship-mapping tuning (2026-06-06 scope-add). Drives the adapter
# relationship contract over the canonical relationship model — finer-grained,
# per-project-resolvable selection that COMPOSES WITH (does not replace) the
# install-level [adapters].ticketing selector in operator.toml.

# Which external system(s) are active as relationship sources. Composes with
# operator.toml [adapters] selectors (those name the install-level surfaces;
# this names which are active relationship sources for a given scope).
# Valid: comma-separated system ids (e.g., "github") — system vocabulary per
#        the active [adapters] selectors.
# Default: "github"
source_systems = "github"

# Maintenance posture for relationship round-tripping per source system.
# Valid: "read-only" | "one-way-push" | "two-way-round-trip"
# Default: "read-only"
maintenance_posture = "read-only"

# Canonical→native relationship-type deviations, per system. A TOML inline-table
# of overrides; empty table = no deviations (use canonical types verbatim).
# Valid: a TOML table mapping canonical-type -> native-type strings.
# Default: {} (no overrides)
type_mapping_overrides = {}

[calibration]
# Calibration metadata for the calibration-policy fields above (e.g.,
# release_size_target_pts carries CALIBRATE-AFTER-3). Records how many releases
# of empirical data have accrued toward a scheduled re-calibration. Advanced by
# the operator (Track B value set) or at a Track A re-calibration PR.
# Shared counter — one calibration loop, two halves: the RELEASE_LOG velocity
# instrument (the measurement half — planned-vs-delivered points, files-changed,
# allocation actuals; see release/references/standards/release-velocity-tracking.md)
# and release_class_capacity_weights above (the heuristic half — recalibrated
# from the per-class delivered-vs-planned ratio after CALIBRATE-AFTER-3). Both
# advance THIS single counter; neither defines a private one. No velocity-specific
# key is needed — the N=3 trigger and the weight defaults already carry the policy.
# Valid: non-negative integer count of releases observed since last calibration.
# Default: 0
releases_since_calibration = 0

[failure_mode_detectors]
# Operator/portfolio-specific threshold seeds for the pmo-qa-auditor Failure-Mode
# Detector Battery (D1-D8). Two detectors read an absolute threshold from this
# section at evaluation time: D6 (breadth burnout) and D8 (trust erosion). The
# other six detectors carry their thresholds inline in the battery and read
# nothing here. The detector definitions, signatures, and threshold semantics are
# canonical in core/skills/pmo-qa-auditor/references/failure-mode-detectors.md -
# this section is the single NUMERIC home for the two config-referenced thresholds;
# the reference cites them by key and does NOT restate these values.
#
# Resolution + fallback: values resolve via the 5-rung Platform-Config Resolution
# Protocol (global default here -> portfolio -> program -> project -> individual).
# A detector whose key cannot be resolved is un-evaluable and reports INDETERMINATE
# for that axis (never silently clean), per the reference's resolution note.

# D6 (breadth burnout) - the maximum sustainable count of concurrent ACTIVE
# workstreams. D6 fires when the concurrent-active count exceeds this ceiling AND
# a >=15-point depth-metric decline occurs window-over-window (conjunction; the
# 15-point band is D4's, carried inline in the reference). This absolute ceiling
# is operator/portfolio-specific and is NOT canonicalized in the reference.
# Calibration policy: MEDIUM-confidence seed - set a per-portfolio value via a
# Layer-2 override; recalibrate the seed from observed audit-window breadth data
# if it proves mis-set. NOT tied to [calibration].releases_since_calibration (that
# counter is the release-velocity loop; this is an audit-window threshold).
# Valid: a positive integer (count of concurrent active workstreams).
# Default: 5
concurrency_ceiling = 5

# D8 (trust erosion) - the walk-back / retraction rate floor, expressed as a
# 0.0-1.0 fraction of claims. D8 fires when the walk-back rate rises
# window-over-window OR exceeds this floor; a persistent rise escalates at the
# hand-off boundary. This absolute rate floor is operator/portfolio-specific and
# is NOT canonicalized in the reference.
# Calibration policy: MEDIUM-confidence seed - set a per-portfolio value via a
# Layer-2 override; recalibrate the seed from observed audit-window walk-back data
# if it proves mis-set. NOT tied to [calibration].releases_since_calibration.
# Valid: a decimal fraction in [0.0, 1.0].
# Default: 0.15
walk_back_rate_floor = 0.15

[progressive_rollout]
# Persistence surface for the release-executor progressive-rollout outcome-log
# (the "rollout-log"). release-executor progressive rollout persists each
# shadow/warn would-fail hit to a per-rule append-only log so an operator can
# review a rule's hit-rate before advancing it shadow -> warn -> enforce. The
# dispatch model, the log fields (ts, rule-id, cycle, verdict, reason, release),
# and the shadow/warn/enforce semantics are canonical in
# release/skills/release-executor/references/progressive-rollout.md - this section
# is the config home for the log's LOCATION + FORMAT only; the reference cites
# these keys by role and owns the behavioral contract.
#
# Log rotation is deliberately NOT configured here: the rollout-logs are
# append-only and rotation folds into the platform's existing warn-log rotation
# follow-up per the reference (do not add a per-file rotation scheme here).

# Directory (repo-relative) where per-rule rollout-logs are written. Reuses the
# established core/hooks/ location + the per-rule *-log.jsonl convention the
# platform's warn-mode hooks already use, so an operator drains these logs with
# the same muscle-memory.
# Valid: a repo-relative directory path string.
# Default: "core/hooks"
rollout_log_dir = "core/hooks"

# Per-rule rollout-log filename pattern. The "<rule-id>" placeholder is replaced
# with the rule or gate id that produced the hit (one log per rule). The
# "-rollout-log" suffix (rather than "-warn-log") signals the line carries a
# "cycle" field spanning both shadow and warn.
# Valid: a filename pattern string containing the "<rule-id>" placeholder and a
#        ".jsonl" extension.
# Default: "<rule-id>-rollout-log.jsonl"
rollout_log_filename_pattern = "<rule-id>-rollout-log.jsonl"

# On-disk log format. Append-only JSON Lines - one JSON object per would-fail hit.
# Valid: "jsonl" (append-only JSON Lines - the only supported format).
# Default: "jsonl"
rollout_log_format = "jsonl"

[spoke_runtime]
# ── CANONICAL edit surface for hub-spawned-spoke MODEL + EFFORT posture (#340) ──
# ONE discoverable home. Consumed by FOUR surfaces:
#   1. deploy.sh Check 27  — config-drift (agent frontmatter model: vs the default/override)
#   2. `### Model Provenance` block (hub-spoke-bridge.md) — invocation-drift
#   3. SessionStart model/effort hook (#339) — runtime-launch drift (reads default + effort pointer)
#   4. hub chip-prompt construction (Procedure 0 resolve-once → inject) — the chip path
#
# TWO SPAWN CLASSES — structurally different propagation; do NOT collapse into one
# mechanism (per #340 AC "document the asymmetry"):
#   • Agent-tool subagents — inherit via .claude/agents/pmo-*.md frontmatter model:/effort:
#     (Anthropic `inherit` semantics: https://code.claude.com/docs/en/sub-agents).
#     Governed by `default_spoke_model` + the per-stage-override companion allowlist.
#   • spawn_task chips — NO inheritance; a fresh session reads ~/.claude/settings.json
#     model + effortLevel at startup (mcp__ccd_session__spawn_task: "no memory of this
#     conversation"). Governed by `chip_model` (hub-injected) + #339 runtime verification.
# The two paths are UNCOUPLED (#340 AC5): their runtime carriers are DIFFERENT files
# (agent frontmatter vs settings.json); editing one knob below never touches the other.

# Default model for subagent-path spoke work. This is the current RESOLUTION of the
# immutable, name-agnostic directive "always highest-tier model" (SSOT:
# ~/.claude/memory/feedback_model_preference.md) — NOT an independent knob. Update
# ONLY when the flagship model NAME changes. Enum: sonnet | opus | haiku.
default_spoke_model = "opus"

# Chip-path model the hub injects into spawn_task chip prompts (chips do not inherit).
# Normally EQUAL to default_spoke_model (both = current flagship per the directive);
# a SEPARATE knob solely so the two spawn classes stay independently tunable (#340 AC5)
# — e.g. an operator trialing a cheaper chip model for a cost-sensitive batch without
# touching subagent posture. Enum: sonnet | opus | haiku.
chip_model = "opus"

# ── EFFORT POSTURE — POINTER, not a stored value (no-shadow-SSOT) ──
# Effort is MAX for all spoke work, per the IMMUTABLE directive (SSOT:
# ~/.claude/memory/feedback_model_preference.md — "MAX effort, name-agnostic"). This
# surface deliberately stores NO mutable effort field: a stored value would shadow the
# directive and drift. The concrete chip-runtime effort lives in ~/.claude/settings.json
# (effortLevel) as the Anthropic chip contract; the #339 SessionStart hook VERIFIES the
# resolved session effort against this directive. To change effort, change the directive
# (governed) — there is no effort field here by design.

# Per-stage model overrides live in the COMPANION allowlist (existing surface, retained):
#   core/config/allowlists/agents-model-overrides.txt   (<agent-name> <model> per line)
# Read by Check 27 + the Model Provenance block. Cross-referenced here as the single
# override sub-surface of this canonical section.

[security_hooks]
# ── MASTER ACTIVATION for the core/hooks/block-* PreToolUse hook layer (#310) ──
# Opt-in, default OFF: a fresh public clone imposes NO workflow guards until the
# operator opts in (at install via docs/scripts/setup-workspace.sh, or by setting
# master_enabled here in the durable individual surface
# ~/.config/pmo-platform/platform-config.toml). The operator VALUE lives in that
# XDG file (Operator-instance category — update.sh never touches it, so the choice
# survives a version upgrade); this in-repo template ships the OFF schema default.
# Read by core/hooks/lib/master-enable.sh with a jq-free grep reader; precedence
# inside each hook is: CLAUDE_HOOK_BYPASS → master_enabled → per-hook .mode → rule.
#
# SECURITY SCOPE (D-R9, ratified SECURITY-EXCLUDED — public-surface security is
# paramount): master_enabled=false disables ONLY the workflow-class hooks
# (block-draft-files, block-fragile-refs, block-fs-boundary, block-mcp-writes,
# block-skill-direct-edit, and the mode-gated ceiling of block-autonomy-ceiling).
# The security/floor-class hooks (block-credential-reads, block-destructive,
# block-rm-prefer-trash, block-egress, block-gh-path-leak, block-scope-segregation,
# block-shell-injection) and the block-autonomy-ceiling Tier-0 always-block floor
# ALWAYS enforce and are NEVER silently disabled by master-OFF — the failure mode
# (a silently-disabled egress/PII hook → a leaked commit/PR on a PUBLIC repo) is
# irreversible. CLAUDE_HOOK_BYPASS remains the operator's per-session, audit-logged
# escape for the always-enforce set.
# Valid: true | false.  Default: false.
master_enabled = false

# R9 security-scope OVERRIDE. false (default + recommended) = the security/floor-class
# hooks are NOT disabled by master_enabled=false (per the D-R9 scope above). Setting
# true is an explicit, logged operator acknowledgment that those hooks may ALSO go
# inert under master-OFF — a public-surface-safety downgrade. Never silently defaulted
# true. (A security hook still honors its OWN per-hook .mode/.scope-segregation-mode/
# git-pre-commit-pii.mode independently of this knob.)
# Valid: true | false.  Default: false.
security_class_master_optout = false

[git_release_automation]
# Git-native release automation (branch creation + naming, PR statusing, CI
# auto-resolution, review-comment resolution).
#
# ALWAYS-ON, NON-TOGGLEABLE (deliberately NOT keys below): feature-branch creation
# timing + naming; PR statusing (draft-on-create -> ready-at-Stage-9). These fire
# whenever the git-based path is detected and expose NO dial; their ABSENCE from
# this section IS the declaration (mechanically assertable — no key below matches
# `branch` or `status`).
#
# ABSENT-KEY CONTRACT (in-code, not template-derived): an absent platform-config.toml,
# an absent section, an absent key, an empty value, or any non-boolean value ALL resolve
# to false (OFF) via a terminal in-code constant in release/tools/lib/platform-toggle.sh.
# Only the literal `true` enables a toggle. A template default alone does NOT reach a
# consumer -- the runtime platform-config.toml is ABSENT on a stock instance, so an
# install that never receives the file must behave identically to a fresh install with
# every toggle off. That equivalence is the contract, not a side effect.
#
# RESOLUTION SCOPE IS 2-RUNG, NOT 5 (a deliberate narrowing, stated because a reader
# otherwise correctly assumes the 5-rung cascade): this section resolves from the global
# rung (this template) and the individual XDG rung only. Rungs 2-4 (portfolio / program /
# project) are semantically inapplicable -- the fact configured here is PLATFORM-scoped
# (one release pipeline per install), not per-portfolio or per-project. The narrowing
# follows the in-file precedent of core/hooks/lib/master-enable.sh, which narrows to the
# individual rung for the same reason.
#
# NO-OP DEGRADATION: off the git-based path every facet -- toggled AND always-on -- is
# inert: no action, no warning, no error, no non-zero exit.
#
# GIT-BASED-PATH DETECTION (no new key -- it reads surfaces that already exist):
#   git_based_path := (the release working tree IS a git work tree)
#                 AND (operator.toml [adapters].repo_host resolves "github";
#                      documented consumer fallback "github")
#                 AND (operator.toml [adapters].ai_tool   resolves "claude-code";
#                      documented consumer fallback "claude-code")
# Honesty note: [adapters] is now DELIVERED into a stock runtime operator.toml (it was
# absent before the declared-schema work; an existing config gains it on the next update
# or reconcile). Both keys carry their documented defaults, which equal the only shipped
# values, so the predicate still reduces to the work-tree clause alone — what changed is
# that the values are readable in the operator's own config rather than resolved from a
# consumer fallback. The two adapter clauses remain a FORWARD host-agnosticism seam, not
# a live three-way test.
#
# RELATIONSHIP TO operator.toml [automation].automation_level: DISJOINT.
# automation_level is the autonomy CEILING (with an irreducible Tier-0 floor beneath it);
# the keys below are capability SWITCHES. A toggle set true never raises the ceiling --
# any action stays clamped by effective = min(automation_level, per-action max), so
# turning one on cannot authorize an action automation_level forbids. Different FILES
# (operator.toml vs this one), different readers, no shared key name or key prefix.

# Valid: true | false.  Default: false.
review_process_integration = false
# Valid: true | false.  Default: false.
ci_auto_resolve = false
# Valid: true | false.  Default: false.
comment_auto_resolution = false

[behavioral_regression]
# The pass-rate floor the behavioral-regression corpus must hold at the major-release
# boundary. The corpus lives at core/disciplines/evals/behavioral-regression/; the gate
# is .github/workflows/behavioral-regression.yml, which READS THIS FIELD and passes it
# to the runner as --fail-under. The runner performs the comparison and sets the exit
# code; the gate consumes only that exit code and never parses the report, so exactly
# one definition of the report contract exists in the tree.
#
# THIS FIELD IS THE SINGLE NUMERIC HOME FOR THE FLOOR AND RESTATES NOTHING ELSE.
# What the number MEANS -- the denominator, the boundary it binds at, and what a
# below-floor run does to a release -- is canonical in
# release/ADRs/ADR-181-behavioral-regression-floor-and-major-release-binding-boundary.md
# and core/standards/regression-checks.md. Those surfaces name the floor BY ROLE and
# never restate its magnitude, so a recalibration moves this line and nothing else.
# (Same convention as [bundling].mode_a_parse_rate_floor above.)
#
# WHY 1.00 RATHER THAN THE 0.90 OF THE RATE-FLOOR PRECEDENT. A regression corpus's
# members are must-hold assertions: any failing scenario IS a regression, by the
# corpus's own definition. A sub-1.0 floor is therefore a standing regression budget --
# you may regress N% forever and stay green -- which is the never-FAIL anti-pattern in a
# different costume. A known-open defect is carried instead as an expected-FAIL
# assertion (`expect: "fail"` per the scenario-eval contract), which holds the rate at
# the floor while keeping the exception named in the run and retirable.
#
# FAIL-CLOSED ON AN UNRESOLVABLE VALUE. A consumer that cannot resolve this field
# must treat it as UNRESOLVED and fail, never as zero: a zero floor satisfies every
# `>=` comparison and would green the gate permanently. This mirrors the
# empty-means-UNRESOLVED contract the platform's other rate-floor readers already
# honour.
# Calibration policy: CALIBRATE-AFTER-3 -- 1.00 is a seed, not a measurement. The
# corpus did not exist when it was set, so there was no observed distribution to
# calibrate against; recalibrate from observed corpus behaviour after 3 releases.
# Valid: a decimal fraction in [0.0, 1.0].
# Default: 1.00
pass_rate_floor = 1.00
