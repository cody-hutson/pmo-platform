# pmo-platform — operator.toml
#
# Canonical operator-instance configuration. Single source of truth for
# the [OPERATOR_*] / [CLAUDE_WORKSPACE_ROOT] / [COWORK_INSTALL_PATH_BASE]
# token vocabulary defined at core/standards/depersonalization-spec.md.
#
# Canonical location: ~/.config/pmo-platform/operator.toml (per XDG Base Directory Spec)
# Per-workspace override: <workspace>/operator.local.toml (optional)
# Resolution order: operator.local.toml > operator.toml > template defaults
# Required permissions: chmod 600 (operator-only read/write)
#
# This file is read at:
#   - Install time by docs/scripts/setup-workspace.sh (token substitution + write resolved files)
#   - Update time by ./update.sh (regenerate managed sections per composition-surface-spec.md § 3.2)
#   - Runtime by deploy.sh, core/hooks/*.sh (read [CLAUDE_WORKSPACE_ROOT] etc.)
#
# Edit this file directly OR run ./update.sh, which reconciles your generated
# operator.toml against the declared schema — backfilling a key the platform has
# added since your config was written, preserving every value you set yourself,
# removing nothing, and prompting only for a key that carries no default.
# After edits, run ./update.sh to regenerate resolved files with new values.

[meta]
# Schema version. Bump on breaking schema changes. update.sh schema migration
# logic keys on this field.
schema_version = 1

# Identification of the managing tool. Do not edit.
managed_by = "pmo-platform"

[identity]
# Operator's full name. Resolves [OPERATOR_NAME].
# Example: "Firstname Lastname"
operator_name = ""

# Operator's primary email. Resolves [OPERATOR_EMAIL].
# Example: "jane.doe@example.com"
operator_email = ""

# Operator's git commit email. Used for Co-Authored-By trailers.
# Defaults to operator_email when unset.
# Resolves [OPERATOR_GIT_EMAIL].
operator_git_email = ""

# Operator's GitHub handle (no @ prefix). Resolves [OPERATOR_GITHUB].
# Used in egress allowlist patterns (repos/<handle>/*), comms-writer signatures,
# and doc prose. Empty string disables GitHub-keyed allowlist entries.
# Example: "jane-doe"
operator_github = ""

# Operator's phone (optional; signature blocks). Resolves [OPERATOR_PHONE].
# Empty string omits phone from signature blocks.
operator_phone = ""

# Operator's role title. Resolves [OPERATOR_ROLE_TITLE].
# Example: "Senior Program Manager"
operator_role_title = ""

# Operator's organization. Resolves [OPERATOR_ORGANIZATION].
# Example: "Acme Corp"
operator_organization = ""

[paths]
# Claude workspace root. Resolves [CLAUDE_WORKSPACE_ROOT].
# Default: $HOME/Claude
# Tilde-prefixed paths expand at read time.
claude_workspace_root = ""

# Operator POSIX home directory. Resolves [OPERATOR_HOMEDIR_PATH].
# Default: $HOME (resolved at read time when this field is empty).
operator_homedir_path = ""

# Cowork install path base. Resolves [COWORK_INSTALL_PATH_BASE].
# Default: $HOME/Library/Application Support/Claude/local-agent-mode-sessions
# Auto-discovered by setup-workspace.sh when empty.
cowork_install_path = ""

# pmo-platform package repository name. Used for egress allowlist patterns
# of the form repos/<operator_github>/<pmo_platform_repo_name>/*.
# Default: "pmo-platform" (canonical upstream name).
# Override only if operator forked under a different name.
pmo_platform_repo_name = "pmo-platform"

# --- Operator-instance path overrides ---
# Resolve <OPERATOR_INSTANCE_*_PATH> angle-bracket tokens per
# core/standards/depersonalization-spec.md §4. Empty string → resolve to
# canonical default (typically ${claude_workspace_root}/pmo-instance/<stem>/).
# Non-empty string → use override verbatim.

# Resolves <OPERATOR_INSTANCE_HUB_STATE_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/hub-state
# Consumer: core/standards/hub-session-continuity.md §2 (runtime persistence
# of pending-approvals, action-items, sessions surfaces).
operator_instance_hub_state_path = ""

# Resolves <OPERATOR_INSTANCE_ROADMAPS_PATH>.
# Default: ${claude_workspace_root}/pmo-platform/roadmaps  (the shipped in-repo
# /roadmaps/ home — folder + README tracked, instances git-ignored, the analysis/
# workspace pattern; ships on install). Per core/ADRs/ADR-046 (in-repo location;
# supersedes-in-part the operator-local placement of ADR-012 + ADR-017). ADR-012's
# "instances are not tracked" decision is preserved — instances stay git-ignored.
# Leave empty to use the default; set a path to repoint (plug-and-play storage).
# The roadmap *framework* convention stays at
# core/standards/initiative-roadmap-framework.md.
operator_instance_roadmaps_path = ""

# Resolves <OPERATOR_INSTANCE_INBOX_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/inbox
# Consumer: the ambient inbox drop-zone (core/standards/c1-ambient-inbox-cursor.md §1)
# — one watched dir where transcripts/emails land for ambient ingest; the dedup
# cursor (.cursor.json) lives here. Read by the Path A scheduled intake sweep (C2).
operator_instance_inbox_path = ""

# Resolves <OPERATOR_INSTANCE_EXTERNAL_SYNC_SNAPSHOT_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/external-sync/snapshot.json
# Consumer: the Path-B external-sync sweep (core/standards/c3-external-sync-path-b.md §3)
# — the persisted poll-state snapshot the sweep diffs against. Holds live external
# IDs/statuses, so it is operator-instance and never git-tracked.
operator_instance_external_sync_snapshot_path = ""

# Resolves <OPERATOR_INSTANCE_EXTERNAL_SYNC_RUNLOG_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/external-sync/run-log.jsonl
# Consumer: the Path-B external-sync sweep (core/standards/c3-external-sync-path-b.md §5)
# — append-only JSONL run-record (one per sweep; carries sweep="external-sync-path-b").
# The producer side of the C3->C4 sweep-digest/heartbeat contract.
operator_instance_external_sync_runlog_path = ""

# Resolves <OPERATOR_INSTANCE_INTAKE_SWEEP_RUNLOG_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/ambient-intake/run-log.jsonl
# Consumer: the Path-A scheduled intake sweep (core/standards/c2-intake-sweep-path-a.md §5)
# — append-only JSONL run-record (one per sweep; carries sweep="intake-path-a").
# Field-aligned to the Path-B run-record; the producer side of the C2->C4 sweep-digest/
# heartbeat contract. A distinct file so the two sweeps' records do not interleave.
operator_instance_intake_sweep_runlog_path = ""

# Resolves <OPERATOR_INSTANCE_EVALS_RESULTS_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/evals/results
# Consumer: the pipeline event-log writer/reader + release-analytics tools
# (release/tools/append-pipeline-event.sh, query-pipeline-event.sh,
# compute-cycle-time.sh, synthesize-release-learnings.sh) read the
# pipeline-event-log.md / calibration-data.md / iteration-log.md surfaces here.
operator_instance_evals_results_path = ""

# Resolves <OPERATOR_INSTANCE_FINOPS_STORE_PATH>.
# Default: ${claude_workspace_root}/pmo-instance/finops
# Consumer: core/schemas/finops-usage-store-schema.md — the Agent-FinOps runtime
# token-spend store (per-session/per-subagent usage records extracted from local
# Claude Code session data by the finops-usage-extractor skill). Git-ignored
# operator-instance data: records carry gitBranch / cwd / work-item identifiers
# and MUST never commit on the public repo.
operator_instance_finops_store_path = ""

[adapters]
# Host-adapter selectors — the four external surfaces the platform integrates
# with (ADR-017 §S2 names operator.toml as the home for "identity, paths,
# methodology, adapters"). This is the canonical onboarding seam: onboarding-time
# operator choices about which host surfaces to use are written here.
# Each selector ships a v1 default so a fresh install runs end-to-end with no
# operator action. These are install-level / individual-tier choices; finer-
# grained per-project relationship-mapping tuning lives in platform-config.toml
# [relationship_mapping] (see core/config/platform-config.toml.template).

# Repository-host adapter — where the platform's git surface and code review live.
# v1 ships GitHub via the `gh` CLI.
# Valid: "github" (GitHub via gh) — additional hosts gated on their adapter tickets.
# Default: "github"
repo_host = "github"

# Ticketing adapter — the work-tracking surface (issues / milestones / board)
# the pipeline reads and writes. SUPERSEDES the legacy [platform].work_board
# field below (kept as a deprecated alias for backward-compat — see [platform]).
# v1 ships GitHub Projects (issues + milestones + a Projects v2 board).
# Valid: "github" (GitHub issues + Projects) | "jira+github" | "gitlab+jira"
# Default: "github"
#
# DEPRECATED-IN-FAVOR-OF the multi-destination [trackers.<id>] subtables (#384,
# below). This single scalar is the SINGLE-destination form; declaring [trackers.*]
# supersedes it with a per-destination scope + routing model. Retained (NOT
# removed) as the back-compat default: with no [trackers.*] declared, filing
# resolves to a single `default` destination derived from this value.
ticketing = "github"

# Knowledge-base adapter — where reference / documentation content is authored
# and read. v1 ships a generic Markdown KB (the repo's own docs/ + reference tree).
# Valid: "markdown" (generic Markdown KB) — Confluence/Notion gated on their tickets.
# Default: "markdown"
kb = "markdown"

# AI-tool adapter — the agent runtime the platform's skills and hub run on.
# v1 ships Claude Code (CLI or Desktop).
# Valid: "claude-code" (Claude Code CLI/Desktop) — other runtimes gated on their tickets.
# Default: "claude-code"
ai_tool = "claude-code"

# --- Multi-destination work-tracker config (#384) -------------------------------
# The [trackers.<id>] NAMED SUBTABLES declare N segregated work-tracker
# destinations, each with a per-destination sensitivity `scope`. This SUPERSEDES
# the single-value [adapters].ticketing selector above (kept as a deprecated
# back-compat alias — see the migration note below). Named subtables (Option B,
# NOT [[trackers]] array-of-tables) are used deliberately: each subtable is a
# UNIQUE section name that round-trips UNCHANGED through the setup-workspace.sh
# write_operator_toml preservation path (two [[trackers]] array blocks would
# collapse to one corrupt block on re-emit).
#
# SHIPPED COMMENTED ON PURPOSE. A fresh install has NO live [trackers.*] section,
# so it resolves to a single `default` destination = today's single-GitHub
# behavior with ZERO operator action (the back-compat branch). UNCOMMENT + fill
# the blocks below only to opt into multi-destination routing + the scope-
# segregation guardrail.
#
# Fields (per destination):
#   id         — stable identifier (matches the subtable key trackers.<id>).
#   platform   — github-issues | github-projects | jira | linear | asana | azure-boards
#   identifier — the destination's concrete address (operator-instance value):
#                repo "owner/name" (github) | project key (jira) | board/team id.
#   scope      — public | private  (destination sensitivity). A `scope: public`
#                destination is content-scanned by the scope-segregation guardrail
#                (core/hooks/block-scope-segregation.sh); private/PII-marked content
#                filed to it is refused. `scope: private` permits PII.
#
# FAIL-CLOSED ROUTING (CD-1): once ANY [trackers.*] is declared, a private-scope
# project with an unset PROJECT.md `work_tracker:` MUST NOT fall through to a
# public destination — filing resolution fails closed (blocks / requires explicit
# selection) rather than defaulting to public. See core/schemas/project-schema.md
# (`work_tracker`) + operations/skills/intake-desk/SKILL.md (routing read path).
#
# [trackers.work]
# id         = "work"
# platform   = "jira"
# identifier = "PROJ"          # your private Jira project key
# scope      = "private"
#
# [trackers.personal]
# id         = "personal"
# platform   = "github-issues"
# identifier = "owner/public-repo"   # your public GitHub repo (owner/name)
# scope      = "public"
#
# Optional: name the fallback destination explicitly when neither an explicit
# selection nor a project's `work_tracker:` resolves. Absent → the single-`default`
# back-compat destination derived from [adapters].ticketing.
# [trackers]
# default_id = "personal"

[projects]
# GitHub Projects (v2) board identifiers — the field / node IDs the pipeline uses
# when it reads or writes the board. Operator-instance values; obtain them once via
# `gh project field-list --owner <handle> --number <n> --format json`. These resolve
# the [OPERATOR_GITHUB_PROJECT_URL] / [OPERATOR_PROJECT_NODE_ID] / [OPERATOR_PROJECTS_*]
# tokens (core/standards/depersonalization-spec.md §1.1). Markdown docs render those
# tokens as-is; no code auto-resolves them today, so this section is the operator's
# canonical record of the IDs. All empty by default; like [adapters]/[automation],
# operator-set values are preserved across update / re-bootstrap (setup-workspace.sh
# write_operator_toml round-trip).

# Resolves [OPERATOR_GITHUB_PROJECT_URL] — the board's web URL.
board_url = ""

# Resolves [OPERATOR_PROJECT_NODE_ID] — the project's GraphQL node ID (PVT_…).
node_id = ""

# Resolves [OPERATOR_PROJECTS_STATUS_FIELD_ID] — the Status single-select field ID.
status_field_id = ""

# Resolves [OPERATOR_PROJECTS_STAGE_FIELD_ID] — the Stage single-select field ID.
stage_field_id = ""

# Resolves [OPERATOR_PROJECTS_VIEW_FIELD_ID] — the Priority field ID (the token name
# says VIEW for backward-compat; it resolves the Priority field).
priority_field_id = ""

# Resolves [OPERATOR_PROJECTS_DATE_FIELD_ID] — the Decision Date field ID.
decision_date_field_id = ""

[platform]
# Work-board adapter. Selects which work-tracking surface the platform
# integrates with. Reserved field per pmo-platform repo-adapter
# parameterization (operator decision tracked in milestone final-consolidation).
# Valid: "github" | "jira+github" | "gitlab+jira"
# Default: "github"
#
# DEPRECATED ALIAS (adapter-config-foundation): superseded by
# [adapters].ticketing above. Retained — NOT removed. It has no current
# internal reader, but it ships here in the template and setup-workspace.sh
# generates it into operator configs, so it is deprecated-not-removed to
# preserve a clean migration path and avoid breaking any operator/external
# config that references it. New consumers SHOULD read [adapters].ticketing.
# When both are set and differ, [adapters].ticketing is authoritative; a future
# Track A governed change may fold this alias once it is confirmed unused
# everywhere.
work_board = "github"

# Comms platform adapter. Selects the team-comms surface comms-writer
# defaults to when authoring messages.
# Valid: "" (none) | "slack" | "teams" | "email"
# Default: "" (no platform-specific formatting)
comms_platform = ""

[methodology]
# Global default delivery approach — the methodology archetype an install
# starts from when a project does NOT set its own `delivery_approach`.
# ADR-017 §S2 names methodology as an operator.toml concern (alongside
# identity / paths / adapters), so the DEFAULT lives here, not in
# platform-config.toml.
#
# This is ONLY the global default + the resolver fallback. The enum, its
# validation (V1-V12), and the Custom block stay canonical in
# core/schemas/project-schema.md and
# release/references/specs/methodology-parameterization-v1.md — this field
# does NOT re-list or re-validate them. A project's own
# `delivery_approach: <value>` in PROJECT.md frontmatter overrides this default
# (the 5-rung resolver's project rung beats the global rung).
#
# Valid: one of the 8 archetypes — Scrum | Kanban | XP | Waterfall | PRINCE2 |
#        SAFe | Hybrid | Custom (per project-schema.md `delivery_approach` enum).
# Default: "Scrum" (the prior implicit "sprint-centric Agile" default made
#          explicit, per the methodology-parameterization keystone).
default_delivery_approach = "Scrum"

[automation]
# Ambient-intake automation governor — the single operator dial that governs how
# much the platform does on its own during ambient intake (scheduled transcript /
# email ingest + external-tracker sync). This is the C0 keystone every ambient-
# intake child (C1–C6) clamps to.
#
# CEILING SEMANTIC: this is a CEILING, not a switch. The effective autonomy of any
# single action is `effective = min(automation_level, per-action max)` — the dial
# can only LOWER a per-action autonomy ceiling, never RAISE one above what that
# action independently permits. Setting it high does not force any high-stakes
# action to run unattended.
#
# IRREDUCIBLE TIER-0 FLOOR: certain actions NEVER unlock at ANY level — they always
# stop for the operator regardless of this setting. The canonical irreducible set is
# `core/specs/autonomy-tiers.md` § Irreducible Human Tasks (financial transactions,
# account creation, security-permission modification, Stage 9 GO/NO-GO, Stage 12
# Execute authorization, governance-file modification, cross-domain bridge writes,
# destructive ops outside the workspace). RAID-Log closes are a Document Tier 1
# stakeholder-facing write and likewise never auto-close at any level.
#
# ENFORCEMENT POSTURE: this dial is ADVISORY/soft today — skills read it and self-
# limit, but nothing mechanically blocks an over-ceiling action. The C5 PreToolUse
# enforcement hook (#1163), which lands in THIS release (v2.07), is what makes the
# ceiling mechanically enforceable; per the hook-suite shakedown convention C5 ships
# WARN-MODE-INITIAL (it reports an over-ceiling action but does not block), and the
# operator FLIPS it from warn to enforce after the shakedown window. Once flipped to
# enforce, the hook HARD-BLOCKS the payload-detectable Tier-0 classes — governance-
# file writes and cross-domain bridge paths — because those are decidable from the
# tool-call payload. The remaining irreducible classes (financial transactions,
# account creation, security-permission modification, and the Stage 9 / Stage 12
# gates) stay OPERATOR-IRREDUCIBLE by convention: they are not mechanically
# detectable from a tool payload, so they rely on the standing convention above, not
# the hook. So: advisory now → warn-mode when C5 lands this release → hard-blocking
# (payload-detectable Tier-0 only) once the operator flips to enforce. Do NOT read
# this dial as "now hard-enforced" unqualified.
#
# PLAIN-LANGUAGE LABELS (set it without TOML/tier knowledge):
#   off          = "Off"               — platform proposes nothing on its own; you drive every cycle.
#   recommend    = "Brief me"          — platform drafts/surfaces, you approve before anything is written.
#   bounded_auto = "Handle the routine" — platform auto-handles low-stakes routine within declared scope;
#                                          high-stakes + the irreducible Tier-0 set still stop for you.
#
# Valid: "off" | "recommend" | "bounded_auto"
# Default: "recommend" (on — drafts/surfaces for your review; nothing auto-written).
#
# WHERE THE DEFAULT ACTUALLY COMES FROM: setup-workspace.sh seeds this key into
# the generated operator.toml at install with the default below, and preserves
# whatever you have set across a re-run, re-bootstrap or reconcile. It does NOT
# read this template to do it — it reads the declaration at
# core/config/operator-toml-schema.json, which is where the default and the
# delivered-vs-opt-in disposition of every key actually live. This file is the
# operator-facing prose for that same key set, and a deploy check asserts the two
# agree in both directions.
#
# History worth keeping: before the declaration existed, the generator carried a
# FIXED schema, so a key added to it reached NEW INSTALLS ONLY — this dial was
# absent from every pre-existing config for six weeks and nothing surfaced it.
# An existing config now converges on the next ./update.sh, or on demand via
# setup-workspace.sh --reconcile-config.
# Change your value in ~/.config/pmo-platform/operator.toml, not here.
automation_level = "recommend"

[session_retro]
# Per-session self-retrospective — the SESSION-grained half of the platform's
# learning capture (the other two grains are the decision moment and the release).
# Read by BOTH the `session-retro` skill (emit / no-op) and the optional `Stop`
# hook `session-retro-trigger.sh` (fire / skip).
#
# SHIPPED INERT. `enabled = false` below means the automatic trigger does nothing
# on this instance, even though the hook is registered — turning it on is a
# deliberate operator edit, not something a platform update does to you. You can
# always run the retro by asking for it ("run the session retro"); that path
# ignores every setting in this block, INCLUDING the sampling threshold. Asking
# for the retro runs it, full stop.
#
# WHEN IT FIRES: at the FIRST turn boundary at which the session clears the
# threshold below — NOT necessarily the last turn of the session. A Stop hook
# cannot tell which turn is the last one (every turn boundary looks identical;
# the final one is only knowable afterwards), so the hook fires at the earliest
# point it can actually observe. Want it later in the session? Raise the floors
# below, or set sample = "significant_only".
#
# WHY SAMPLING MATTERS: the event log is append-only and permanent. A row emitted
# for a session that taught nothing can never be deleted, only redacted, and it
# permanently dilutes the cross-session pattern signal this surface exists to
# produce. "Almost per session" is a ceiling with a floor under it, not "always".
#
# ACTIVATION IS THREE STEPS (the warn-then-enforce shakedown the platform uses for
# every new runtime hook):
#   1. enabled = true   -> the hook starts evaluating, still does not interrupt
#   2. observe          -> let real sessions accumulate until the hook has recorded
#                          at least one would-fire verdict in its verdict log
#                          (.session-retro-state/verdict-log.tsv, beside the other
#                          hook state files). That row is the proof the whole path
#                          works end to end on a real session.
#   3. mode = "enforce" -> the hook actually runs the retro
#
# Step 2 is enforced, not advisory. Setting mode = "enforce" with an empty verdict
# log does NOT interrupt anything: the hook degrades to warn for that invocation
# and records `warn-window-unsatisfied`, so you can see it happen rather than
# wondering why nothing fired.

# Master switch for the AUTOMATIC trigger. false = the Stop hook is a no-op.
# Valid: true | false          Default: false (inert — activation is your call)
enabled = false

# Hook posture. "off" never fires. "warn" evaluates the threshold and records the
# verdict without interrupting the session (the shakedown posture). "enforce"
# actually asks the agent to run the retro at the session boundary.
# Valid: "off" | "warn" | "enforce"        Default: "warn"
mode = "warn"

# Which sessions clear the threshold:
#   "all"              — every session, including trivial ones (accepts the noise)
#   "almost_all"       — skip ONLY sessions that are trivial on BOTH axes below
#                        (a long conversation with few tools still runs; so does a
#                        short burst of heavy tool work)
#   "significant_only" — run only when BOTH floors below are met
# Valid: "all" | "almost_all" | "significant_only"     Default: "almost_all"
sample = "almost_all"

# The two triviality floors. [CALIBRATE-AFTER-3] — these are starting values, not
# measured ones: no session-size distribution exists yet, because this is the
# release that begins collecting it. Tune them after a warn window of real
# sessions by comparing the recorded fire/skip verdicts against your own read of
# which sessions were worth reflecting on.
min_tool_calls = 12
min_turns = 4
