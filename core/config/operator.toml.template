# pmo-platform — operator.toml
#
# Canonical operator-instance configuration. Single source of truth for
# the [OPERATOR_*] / [CLAUDE_WORKSPACE_ROOT] / [COWORK_INSTALL_PATH_BASE]
# token vocabulary defined at core/standards/depersonalization-spec.md.
#
# Canonical location: ~/.config/pmo-platform/operator.toml (per XDG Base Directory Spec)
# Per-workspace override: <workspace>/operator.local.toml (optional)
# Resolution order: operator.local.toml > operator.toml > template defaults
# Required permissions: chmod 600 (operator-only read/write)
#
# This file is read at:
#   - Install time by docs/scripts/setup-workspace.sh (token substitution + write resolved files)
#   - Update time by ./update.sh (regenerate managed sections per composition-surface-spec.md § 3.2)
#   - Runtime by deploy.sh, core/hooks/*.sh (read [CLAUDE_WORKSPACE_ROOT] etc.)
#
# Edit this file directly OR run ./update.sh which prompts for missing values.
# After edits, run ./update.sh to regenerate resolved files with new values.

[meta]
# Schema version. Bump on breaking schema changes. update.sh schema migration
# logic keys on this field.
schema_version = 1

# Identification of the managing tool. Do not edit.
managed_by = "pmo-platform"

[identity]
# Operator's full name. Resolves [OPERATOR_NAME].
# Example: "Firstname Lastname"
operator_name = ""

# Operator's primary email. Resolves [OPERATOR_EMAIL].
# Example: "jane.doe@example.com"
operator_email = ""

# Operator's git commit email. Used for Co-Authored-By trailers.
# Defaults to operator_email when unset.
# Resolves [OPERATOR_GIT_EMAIL].
operator_git_email = ""

# Operator's GitHub handle (no @ prefix). Resolves [OPERATOR_GITHUB].
# Used in egress allowlist patterns (repos/<handle>/*), comms-writer signatures,
# and doc prose. Empty string disables GitHub-keyed allowlist entries.
# Example: "jane-doe"
operator_github = ""

# Operator's phone (optional; signature blocks). Resolves [OPERATOR_PHONE].
# Empty string omits phone from signature blocks.
operator_phone = ""

# Operator's role title. Resolves [OPERATOR_ROLE_TITLE].
# Example: "Senior Program Manager"
operator_role_title = ""

# Operator's organization. Resolves [OPERATOR_ORGANIZATION].
# Example: "Acme Corp"
operator_organization = ""

[paths]
# Claude workspace root. Resolves [CLAUDE_WORKSPACE_ROOT].
# Default: $HOME/Claude
# Tilde-prefixed paths expand at read time.
claude_workspace_root = ""

# Operator POSIX home directory. Resolves [OPERATOR_HOMEDIR_PATH].
# Default: $HOME (resolved at read time when this field is empty).
operator_homedir_path = ""

# Cowork install path base. Resolves [COWORK_INSTALL_PATH_BASE].
# Default: $HOME/Library/Application Support/Claude/local-agent-mode-sessions
# Auto-discovered by setup-workspace.sh when empty.
cowork_install_path = ""

# pmo-platform package repository name. Used for egress allowlist patterns
# of the form repos/<operator_github>/<pmo_platform_repo_name>/*.
# Default: "pmo-platform" (canonical upstream name).
# Override only if operator forked under a different name.
pmo_platform_repo_name = "pmo-platform"

# --- Operator-instance path overrides ---
# Resolve <OPERATOR_INSTANCE_*_PATH> angle-bracket tokens per
# core/standards/depersonalization-spec.md §4. Empty string → resolve to
# canonical default (typically ${claude_workspace_root}/personal/pmo-instance/<stem>/).
# Non-empty string → use override verbatim.

# Resolves <OPERATOR_INSTANCE_HUB_STATE_PATH>.
# Default: ${claude_workspace_root}/personal/pmo-instance/hub-state
# Consumer: core/standards/hub-session-continuity.md §2 (runtime persistence
# of pending-approvals, action-items, sessions surfaces).
operator_instance_hub_state_path = ""

# Resolves <OPERATOR_INSTANCE_ROADMAPS_PATH>.
# Default: ${claude_workspace_root}/personal/pmo-instance/roadmaps
# Consumer: initiative-roadmap *instances* are authored operator-local here,
# de-scoped from the tracked tree per core/ADRs/ADR-012. The roadmap
# *framework* convention stays in-repo at
# core/standards/initiative-roadmap-framework.md.
operator_instance_roadmaps_path = ""

# Resolves <OPERATOR_INSTANCE_INBOX_PATH>.
# Default: ${claude_workspace_root}/personal/pmo-instance/inbox
# Consumer: the ambient inbox drop-zone (core/standards/c1-ambient-inbox-cursor.md §1)
# — one watched dir where transcripts/emails land for ambient ingest; the dedup
# cursor (.cursor.json) lives here. Read by the Path A scheduled intake sweep (C2).
operator_instance_inbox_path = ""

# Resolves <OPERATOR_INSTANCE_EXTERNAL_SYNC_SNAPSHOT_PATH>.
# Default: ${claude_workspace_root}/personal/pmo-instance/external-sync/snapshot.json
# Consumer: the Path-B external-sync sweep (core/standards/c3-external-sync-path-b.md §3)
# — the persisted poll-state snapshot the sweep diffs against. Holds live external
# IDs/statuses, so it is operator-instance and never git-tracked.
operator_instance_external_sync_snapshot_path = ""

# Resolves <OPERATOR_INSTANCE_EXTERNAL_SYNC_RUNLOG_PATH>.
# Default: ${claude_workspace_root}/personal/pmo-instance/external-sync/run-log.jsonl
# Consumer: the Path-B external-sync sweep (core/standards/c3-external-sync-path-b.md §5)
# — append-only JSONL run-record (one per sweep; carries sweep="external-sync-path-b").
# The producer side of the C3->C4 sweep-digest/heartbeat contract.
operator_instance_external_sync_runlog_path = ""

[adapters]
# Host-adapter selectors — the four external surfaces the platform integrates
# with (ADR-017 §S2 names operator.toml as the home for "identity, paths,
# methodology, adapters"). This is the canonical onboarding seam: onboarding-time
# operator choices about which host surfaces to use are written here.
# Each selector ships a v1 default so a fresh install runs end-to-end with no
# operator action. These are install-level / individual-tier choices; finer-
# grained per-project relationship-mapping tuning lives in platform-config.toml
# [relationship_mapping] (see core/config/platform-config.toml.template).

# Repository-host adapter — where the platform's git surface and code review live.
# v1 ships GitHub via the `gh` CLI.
# Valid: "github" (GitHub via gh) — additional hosts gated on their adapter tickets.
# Default: "github"
repo_host = "github"

# Ticketing adapter — the work-tracking surface (issues / milestones / board)
# the pipeline reads and writes. SUPERSEDES the legacy [platform].work_board
# field below (kept as a deprecated alias for backward-compat — see [platform]).
# v1 ships GitHub Projects (issues + milestones + a Projects v2 board).
# Valid: "github" (GitHub issues + Projects) | "jira+github" | "gitlab+jira"
# Default: "github"
ticketing = "github"

# Knowledge-base adapter — where reference / documentation content is authored
# and read. v1 ships a generic Markdown KB (the repo's own docs/ + reference tree).
# Valid: "markdown" (generic Markdown KB) — Confluence/Notion gated on their tickets.
# Default: "markdown"
kb = "markdown"

# AI-tool adapter — the agent runtime the platform's skills and hub run on.
# v1 ships Claude Code (CLI or Desktop).
# Valid: "claude-code" (Claude Code CLI/Desktop) — other runtimes gated on their tickets.
# Default: "claude-code"
ai_tool = "claude-code"

[platform]
# Work-board adapter. Selects which work-tracking surface the platform
# integrates with. Reserved field per pmo-platform repo-adapter
# parameterization (operator decision tracked in milestone final-consolidation).
# Valid: "github" | "jira+github" | "gitlab+jira"
# Default: "github"
#
# DEPRECATED ALIAS (adapter-config-foundation): superseded by
# [adapters].ticketing above. Retained — NOT removed. It has no current
# internal reader, but it ships here in the template and setup-workspace.sh
# generates it into operator configs, so it is deprecated-not-removed to
# preserve a clean migration path and avoid breaking any operator/external
# config that references it. New consumers SHOULD read [adapters].ticketing.
# When both are set and differ, [adapters].ticketing is authoritative; a future
# Track A governed change may fold this alias once it is confirmed unused
# everywhere.
work_board = "github"

# Comms platform adapter. Selects the team-comms surface comms-writer
# defaults to when authoring messages.
# Valid: "" (none) | "slack" | "teams" | "email"
# Default: "" (no platform-specific formatting)
comms_platform = ""

[methodology]
# Global default delivery approach — the methodology archetype an install
# starts from when a project does NOT set its own `delivery_approach`.
# ADR-017 §S2 names methodology as an operator.toml concern (alongside
# identity / paths / adapters), so the DEFAULT lives here, not in
# platform-config.toml.
#
# This is ONLY the global default + the resolver fallback. The enum, its
# validation (V1-V12), and the Custom block stay canonical in
# core/schemas/project-schema.md and
# release/references/specs/methodology-parameterization-v1.md — this field
# does NOT re-list or re-validate them. A project's own
# `delivery_approach: <value>` in PROJECT.md frontmatter overrides this default
# (the 5-rung resolver's project rung beats the global rung).
#
# Valid: one of the 8 archetypes — Scrum | Kanban | XP | Waterfall | PRINCE2 |
#        SAFe | Hybrid | Custom (per project-schema.md `delivery_approach` enum).
# Default: "Scrum" (the prior implicit "sprint-centric Agile" default made
#          explicit, per the methodology-parameterization keystone).
default_delivery_approach = "Scrum"

[automation]
# Ambient-intake automation governor — the single operator dial that governs how
# much the platform does on its own during ambient intake (scheduled transcript /
# email ingest + external-tracker sync). This is the C0 keystone every ambient-
# intake child (C1–C6) clamps to.
#
# CEILING SEMANTIC: this is a CEILING, not a switch. The effective autonomy of any
# single action is `effective = min(automation_level, per-action max)` — the dial
# can only LOWER a per-action autonomy ceiling, never RAISE one above what that
# action independently permits. Setting it high does not force any high-stakes
# action to run unattended.
#
# IRREDUCIBLE TIER-0 FLOOR: certain actions NEVER unlock at ANY level — they always
# stop for the operator regardless of this setting. The canonical irreducible set is
# `core/specs/autonomy-tiers.md` § Irreducible Human Tasks (financial transactions,
# account creation, security-permission modification, Stage 9 GO/NO-GO, Stage 12
# Execute authorization, governance-file modification, cross-domain bridge writes,
# destructive ops outside the workspace). RAID-Log closes are a Document Tier 1
# stakeholder-facing write and likewise never auto-close at any level.
#
# ENFORCEMENT POSTURE: this dial is ADVISORY/soft today — skills read it and self-
# limit, but nothing mechanically blocks an over-ceiling action. The C5 PreToolUse
# enforcement hook (#1163), which lands in THIS release (v2.07), is what makes the
# ceiling mechanically enforceable; per the hook-suite shakedown convention C5 ships
# WARN-MODE-INITIAL (it reports an over-ceiling action but does not block), and the
# operator FLIPS it from warn to enforce after the shakedown window. Once flipped to
# enforce, the hook HARD-BLOCKS the payload-detectable Tier-0 classes — governance-
# file writes and cross-domain bridge paths — because those are decidable from the
# tool-call payload. The remaining irreducible classes (financial transactions,
# account creation, security-permission modification, and the Stage 9 / Stage 12
# gates) stay OPERATOR-IRREDUCIBLE by convention: they are not mechanically
# detectable from a tool payload, so they rely on the standing convention above, not
# the hook. So: advisory now → warn-mode when C5 lands this release → hard-blocking
# (payload-detectable Tier-0 only) once the operator flips to enforce. Do NOT read
# this dial as "now hard-enforced" unqualified.
#
# PLAIN-LANGUAGE LABELS (set it without TOML/tier knowledge):
#   off          = "Off"               — platform proposes nothing on its own; you drive every cycle.
#   recommend    = "Brief me"          — platform drafts/surfaces, you approve before anything is written.
#   bounded_auto = "Handle the routine" — platform auto-handles low-stakes routine within declared scope;
#                                          high-stakes + the irreducible Tier-0 set still stop for you.
#
# Valid: "off" | "recommend" | "bounded_auto"
# Default: "recommend" (on — drafts/surfaces for your review; nothing auto-written).
automation_level = "recommend"
